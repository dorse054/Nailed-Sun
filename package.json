{
  "name": "nailed-sun",
  "version": "0.1.0",
  "private": true,
  "description": "Nailed Sun: a Total War-style strategy prototype under a tidally locked sun. Deterministic battle sim, four factions, campaign, balance simulator.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "tsx tools/balance.ts",
    "stats:csv": "tsx tools/stats-csv.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.1"
  }
}
